{
  "name": "tsugu-ai-video",
  "private": true,
  "version": "0.0.0",
  "description": "TSUGU AI 3分デモ動画の録画・編集用の道具（アプリ本体とは別。ffmpeg-static は video/ の中だけに入れる）",
  "type": "module",
  "scripts": {
    "record": "node record.mjs",
